ROOT = Path('/etc/freeradius/3.0')
STATE_DIR = Path('/etc/cockpit-radius')
CONFIG = STATE_DIR / 'config.json'
AUDIT = Path('/var/log/cockpit-radius-audit.jsonl')
AUTH_LOG = Path('/var/log/freeradius/cockpit-radius-auth.log')
ACCT_LOG = Path('/var/log/freeradius/cockpit-radius-accounting.log')
RADIUS_LOG = Path('/var/log/freeradius/radius.log')
CERT_DIR = ROOT / 'certs/cockpit-radius'
CA_CERT = CERT_DIR / 'ca.pem'
CA_KEY = CERT_DIR / 'ca.key'
SERVER_CERT = CERT_DIR / 'server.pem'
SERVER_KEY = CERT_DIR / 'server.key'
CLIENTS_FILE = ROOT / 'clients.d/cockpit-radius.conf'
MSCHAP_FILE = ROOT / 'mods-available/mschap'
PAP_FILE = ROOT / 'mods-available/cockpit_ad_pap'
LOG_FILE = ROOT / 'mods-available/cockpit_radius_log'
SITE_FILE = ROOT / 'sites-available/cockpit-radius'
EAP_FILE = ROOT / 'mods-available/eap'
